# ==============================================================================
# KrishiDrishti AI Platform — Environment Configuration Template
# SIH 2026 · Problem Statement 26131
# ==============================================================================
# Copy this file to .env and fill in the required credentials.
# Any unconfigured service will gracefully operate in truthful DEMO/STAGED mode.

# ------------------------------------------------------------------------------
# 1. CORE NETWORKING & SERVICE PORTS
# ------------------------------------------------------------------------------
IMAGE_AI_URL=http://127.0.0.1:8001
KRISHI_CASES_API=http://127.0.0.1:8002
PORT=8001
CASES_API_PORT=8002
KRISHIDRISHTI_CONFIG=configs/default.yaml

# ------------------------------------------------------------------------------
# 2. META WHATSAPP CLOUD API (GRAPH API v19.0)
# ------------------------------------------------------------------------------
# Set to activate 🟢 LIVE WhatsApp messaging.
# When omitted, the platform runs in 🟡 DEMO / STAGED mode with an in-memory outbox.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=krishidrishti_webhook_secret_2026
WHATSAPP_API_VERSION=v19.0

# ------------------------------------------------------------------------------
# 3. SPEECH-TO-TEXT (STT) VOICE PROCESSING
# ------------------------------------------------------------------------------
# Set to activate 🟢 LIVE Marathi/Hindi speech-to-text recognition.
# Supports Groq Whisper (free & ultrafast) or OpenAI Whisper API.
# Provider options: 'groq' (default) or 'openai'
STT_PROVIDER=groq
STT_API_KEY=
# Or dedicated keys:
GROQ_API_KEY=
OPENAI_API_KEY=
STT_MODEL=whisper-large-v3

# ------------------------------------------------------------------------------
# 4. GOOGLE EARTH ENGINE (GEE) SATELLITE SENSOR
# ------------------------------------------------------------------------------
# Set to activate 🟢 LIVE Sentinel-2 MSI and Sentinel-1 SAR anomaly queries.
# When omitted, the platform runs in 🟡 DEMO / PRECOMPUTED mode using verified indices.
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_PROJECT_ID=
GEE_PRIVATE_KEY=
# Alternatively, specify path to private key file:
GEE_PRIVATE_KEY_PATH=

# GEE Anomaly Detection Parameters
GEE_ANALYSIS_DATE_WINDOW_DAYS=7
GEE_PERCENTILE_THRESHOLD=95.0
GEE_ZSCORE_THRESHOLD=2.5
GEE_MIN_CLUSTER_SIZE=3

# ------------------------------------------------------------------------------
# 5. DIAGNOSIS & MULTI-SIGNAL RISK FUSION
# ------------------------------------------------------------------------------
QUALITY_BLUR_THRESHOLD=60.0
FUSION_IMAGE_WEIGHT=0.40
FUSION_SATELLITE_WEIGHT=0.35
FUSION_OUTBREAK_WEIGHT=0.15
FUSION_URGENCY_WEIGHT=0.10
